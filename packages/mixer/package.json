{
  "name": "@axieinfinity/mixer",
  "version": "1.4.9",
  "description": "Axie Infinity Mixer - TypeScript Source",
  "license": "MIT",
  "author": "Axie Infinity Engineering Team",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "bn.js": "5.2.1"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.5",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  },
  "keywords": [
    "axie",
    "infinity",
    "axie-infinity",
    "mixer",
    "axie-mixer",
    "axie-infinity-mixer",
    "ronin",
    "javascript",
    "typescript"
  ]
}
